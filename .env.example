# Скопируйте в .env и заполните: cp .env.example .env
# .env не попадает в git. Ключи никому не пересылайте.

# Кто строит граф по конспекту:
#   openai   — любой OpenAI-совместимый API (DeepSeek через ProxyAPI, OpenRouter и т. п.)
#   gigachat — GigaChat от Сбера
#   stub     — заглушка без сети, для разработки
LLM_PROVIDER=openai

# --- OpenAI-совместимый провайдер (например, DeepSeek через ProxyAPI) ---
# Базовый URL и точное имя модели — из каталога моделей в личном кабинете провайдера.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- GigaChat (developers.sber.ru → проект GigaChat API → «Получить ключ») ---
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — для физлиц (Freemium)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# Сертификат «Russian Trusted Root CA» (скачать: https://www.gosuslugi.ru/crt), без него HTTPS к Сберу не проверится.
GIGACHAT_CA_FILE=

# --- Общие настройки ---
# Отдельный проход модели, который ищет ошибки в формулах конспекта.
LLM_CHECK_PHYSICS=true
# Сколько конспектов можно загрузить с одного IP за час.
UPLOADS_PER_HOUR=10
